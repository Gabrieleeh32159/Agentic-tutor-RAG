# PostgreSQL (matches docker-compose.yml)
DATABASE_URL="postgresql+asyncpg://challenge:challenge@localhost:5432/challenge_db"

# Embeddings / chat providers
# At minimum, set OPENAI_API_KEY. ANTHROPIC_API_KEY is optional (used for Step 3 fallback).
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

# Models (defaults are fine to leave blank and hardcode reasonable defaults)
EMBEDDING_MODEL="text-embedding-3-small"
CHAT_MODEL="gpt-4o-mini"

# App
APP_ENV="local"
LOG_LEVEL="INFO"
